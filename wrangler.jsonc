{
  "name": "whitespace-plan-reviewer-trial",
  "workers_dev": true,
  "preview_urls": false,
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-20",
  "containers": [{
    "class_name": "PlanReviewer",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "./Dockerfile" } }
  }],
  "durable_objects": {
    "bindings": [{ "name": "REVIEWER", "class_name": "PlanReviewer" }]
  },
  "exports": {
    "PlanReviewer": { "type": "durable-object", "storage": "sqlite" }
  }
}
